PATCH  http://localhost:4004/odata/v4/CatalogService/EmployeeSet/ecf79a01-19a7-4edf-8659-69cbb84c32c2
Content-Type: application/json

    {
      "SALARYAMOUNT": "2200"      
    }  
   
